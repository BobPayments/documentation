{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "name": "Bob Payments",
  "description": "Documentação da API Bob Payments — uma integração para criar, acompanhar e conciliar pagamentos com PIX, cartão de crédito e cripto em beta.",
  "logo": {
    "light": "/logo/bob-logo-sm.webp",
    "dark": "/logo/bob-logo-sm.webp",
    "href": "/pages/introduction"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#087A60",
    "light": "#5EE0B5",
    "dark": "#087A60"
  },
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1210"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Repositório",
        "href": "https://github.com/BobPayments/documentation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.payments.bob.company"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Produto",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.payments.bob.company"
          },
          {
            "label": "Preços",
            "href": "https://app.payments.bob.company/pricing"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Documentação",
            "href": "/"
          }
        ]
      },
      {
        "header": "Suporte",
        "items": [
          {
            "label": "Falar com o suporte",
            "href": "mailto:suporte@payments.bob.company"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Buscar..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    },
    {
      "source": "/en",
      "destination": "/en/pages/introduction"
    },
    {
      "source": "/api-reference",
      "destination": "/pages/pix/reference"
    },
    {
      "source": "/api-reference/criar-nova-transação",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/api-reference/listar-todas-as-transações",
      "destination": "/pages/pix/list"
    },
    {
      "source": "/api-reference/buscar-transação-por-id",
      "destination": "/pages/pix/check-status"
    },
    {
      "source": "/api-reference/simular-pagamento-de-transação-sandbox",
      "destination": "/pages/pix/simulate-payment"
    },
    {
      "source": "/api-reference/checkout/criar-sessão-de-checkout",
      "destination": "/pages/checkout/create"
    },
    {
      "source": "/api-reference/checkout/consultar-status-da-sessão",
      "destination": "/pages/checkout/status"
    },
    {
      "source": "/api-reference/listar-todos-os-clientes",
      "destination": "/pages/customers/list"
    },
    {
      "source": "/api-reference/buscar-cliente-por-id",
      "destination": "/pages/customers/get"
    },
    {
      "source": "/api-reference/buscar-detalhes-da-loja",
      "destination": "/pages/store/get"
    },
    {
      "source": "/docs/public/introduction",
      "destination": "/pages/introduction"
    },
    {
      "source": "/docs/public/quickstart/authentication",
      "destination": "/pages/authentication"
    },
    {
      "source": "/docs/public/quickstart/first-transaction",
      "destination": "/pages/quickstart"
    },
    {
      "source": "/docs/public/guides/complete-integration",
      "destination": "/pages/production"
    },
    {
      "source": "/docs/public/guides/response-format",
      "destination": "/pages/errors"
    },
    {
      "source": "/docs/public/guides/rate-limiting",
      "destination": "/pages/errors"
    },
    {
      "source": "/docs/public/guides/idempotency",
      "destination": "/pages/idempotency"
    },
    {
      "source": "/docs/public/api-reference/transaction-lifecycle",
      "destination": "/pages/concepts/transactions"
    },
    {
      "source": "/docs/public/api-reference/create-pix",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/docs/public/api-reference/list-transactions",
      "destination": "/pages/pix/list"
    },
    {
      "source": "/docs/public/api-reference/check-status",
      "destination": "/pages/pix/check-status"
    },
    {
      "source": "/docs/public/api-reference/errors",
      "destination": "/pages/errors"
    },
    {
      "source": "/docs/public/api-reference/create-customer",
      "destination": "/pages/customers/reference"
    },
    {
      "source": "/docs/public/api-reference/get-customer",
      "destination": "/pages/customers/get"
    },
    {
      "source": "/docs/public/api-reference/list-customers",
      "destination": "/pages/customers/list"
    },
    {
      "source": "/docs/public/api-reference/get-store",
      "destination": "/pages/store/get"
    },
    {
      "source": "/docs/public/sandbox/overview",
      "destination": "/pages/sandbox"
    },
    {
      "source": "/docs/public/sandbox/simulate-payment",
      "destination": "/pages/pix/simulate-payment"
    },
    {
      "source": "/docs/public/sdks/overview",
      "destination": "/pages/sdk/overview"
    },
    {
      "source": "/docs/public/webhooks/overview",
      "destination": "/pages/concepts/webhooks"
    },
    {
      "source": "/docs/public/webhooks/events",
      "destination": "/pages/webhooks"
    },
    {
      "source": "/docs/public/webhooks/signature-verification",
      "destination": "/pages/webhooks"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.payments.bob.company",
      "auth": {
        "method": "bearer"
      }
    }
  },
