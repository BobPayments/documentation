{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "name": "Bob Payments",
  "description": "Documentação da API Bob Payments — uma integração para criar, acompanhar e conciliar pagamentos com PIX e cartão de crédito, com suporte a novos métodos no futuro.",
  "logo": {
    "light": "https://resend-attachments.s3.amazonaws.com/bbjVzq13Vc2xBio",
    "dark": "https://resend-attachments.s3.amazonaws.com/bbjVzq13Vc2xBio"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#087A60",
    "light": "#5EE0B5",
    "dark": "#087A60"
  },
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1210"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Repositório",
        "href": "https://github.com/BobPayments/documentation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.payments.bob.company"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Produto",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.payments.bob.company"
          },
          {
            "label": "Preços",
            "href": "https://app.payments.bob.company/pricing"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Documentação",
            "href": "/"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Buscar..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.payments.bob.company",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Primeiros passos",
            "pages": [
              "pages/introduction",
              "pages/quickstart"
            ]
          },
          {
            "group": "Conceitos principais",
            "pages": [
              "pages/concepts/payment-flow",
              "pages/concepts/transactions",
              "pages/concepts/customers",
              "pages/concepts/webhooks"
            ]
          },
          {
            "group": "Usando a Bob",
            "pages": [
              "pages/sandbox",
              "pages/authentication",
              "pages/production"
            ]
          },
          {
            "group": "Guias de integração",
            "pages": [
              "pages/payments",
              "pages/checkout/overview",
              "pages/pix/create"
            ]
          },
          {
            "group": "Métodos de pagamento",
            "pages": [
              {
                "group": "PIX",
                "expanded": false,
                "pages": [
                  "pages/pix/reference",
                  "pages/pix/simulate-payment"
                ]
              },
              {
                "group": "Cartão de crédito",
                "expanded": false,
                "pages": [
                  "pages/credit-card/overview",
                  "pages/credit-card/reference"
                ]
              }
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "pages/webhooks"
            ]
          },
          {
            "group": "Fundamentos da API",
            "pages": [
              "pages/idempotency",
              "pages/errors"
            ]
          },
          {
            "group": "Recursos da API",
            "pages": [
              {
                "group": "Transações",
                "expanded": false,
                "pages": [
                  "pages/pix/list",
                  "pages/pix/check-status"
                ]
              },
              {
                "group": "Checkout",
                "expanded": false,
                "pages": [
                  "pages/checkout/create",
                  "pages/checkout/status"
                ]
              },
              {
                "group": "Clientes",
                "expanded": false,
                "pages": [
                  "pages/customers/reference",
                  "pages/customers/get",
                  "pages/customers/list"
                ]
              },
              {
                "group": "Projeto",
                "expanded": false,
                "pages": [
                  "pages/store/reference",
                  "pages/store/get"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "openapi": "openapi.yaml"
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Comece aqui",
            "pages": [
              "pages/sdk/overview"
            ]
          },
          {
            "group": "Servidor",
            "pages": [
              "pages/sdk/node",
              "pages/sdk/php"
            ]
          },
          {
            "group": "Frontend",
            "pages": [
              "pages/sdk/checkout"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "href": "https://github.com/BobPayments/documentation/blob/main/CHANGELOG.md"
      }
    ]
  }
}
