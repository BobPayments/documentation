{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bob Payments",
  "description": "Documentação da API Bob Payments — uma integração para criar, acompanhar e conciliar pagamentos com PIX e cartão de crédito, com suporte a novos métodos no futuro.",
  "logo": {
    "light": "https://resend-attachments.s3.amazonaws.com/bbjVzq13Vc2xBio",
    "dark": "https://resend-attachments.s3.amazonaws.com/bbjVzq13Vc2xBio"
  },
  "favicon": "https://resend-attachments.s3.amazonaws.com/bbjVzq13Vc2xBio",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "navbar": {
    "links": [
      {
        "label": "Repositório",
        "href": "https://github.com/BobPayments/documentation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.payments.bob.company"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Produto",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.payments.bob.company"
          },
          {
            "label": "Preços",
            "href": "https://app.payments.bob.company/pricing"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Documentação",
            "href": "/"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Buscar na documentação..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.payments.bob.company",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Introdução",
            "pages": [
              "pages/introduction",
              "pages/payments",
              "pages/sandbox",
              "pages/authentication",
              "pages/webhooks",
              "pages/errors",
              "pages/idempotency",
              "pages/production"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "pages/sdk/overview",
              {
                "group": "Servidor",
                "pages": [
                  "pages/sdk/node",
                  "pages/sdk/php"
                ]
              },
              {
                "group": "Frontend",
                "pages": [
                  "pages/sdk/checkout"
                ]
              }
            ]
          },
          {
            "group": "PIX",
            "pages": [
              "pages/pix/create",
              "pages/pix/reference",
              "pages/pix/simulate-payment"
            ]
          },
          {
            "group": "Cartão de crédito",
            "pages": [
              "pages/credit-card/overview",
              "pages/credit-card/reference"
            ]
          },
          {
            "group": "Transações",
            "pages": [
              "pages/pix/list",
              "pages/pix/check-status"
            ]
          },
          {
            "group": "Checkout",
            "pages": [
              "pages/checkout/overview",
              "pages/checkout/create",
              "pages/checkout/status"
            ]
          },
          {
            "group": "Clientes",
            "pages": [
              "pages/customers/reference",
              "pages/customers/get",
              "pages/customers/list"
            ]
          },
          {
            "group": "Loja",
            "pages": [
              "pages/store/reference",
              "pages/store/get"
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "openapi": "openapi.yaml"
      }
    ]
  }
}
