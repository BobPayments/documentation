{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "name": "Bob Payments",
  "description": "Documentação da API Bob Payments — uma integração para criar, acompanhar e conciliar pagamentos com PIX e cartão de crédito, com suporte a novos métodos no futuro.",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/pages/introduction"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#087A60",
    "light": "#5EE0B5",
    "dark": "#087A60"
  },
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1210"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Repositório",
        "href": "https://github.com/BobPayments/documentation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.payments.bob.company"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Produto",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.payments.bob.company"
          },
          {
            "label": "Preços",
            "href": "https://app.payments.bob.company/pricing"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Documentação",
            "href": "/"
          }
        ]
      },
      {
        "header": "Suporte",
        "items": [
          {
            "label": "Falar com o suporte",
            "href": "mailto:suporte@payments.bob.company"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Buscar..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    },
    {
      "source": "/api-reference",
      "destination": "/pages/pix/reference"
    },
    {
      "source": "/api-reference/criar-nova-transação",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/api-reference/listar-todas-as-transações",
      "destination": "/pages/pix/list"
    },
    {
      "source": "/api-reference/buscar-transação-por-id",
      "destination": "/pages/pix/check-status"
    },
    {
      "source": "/api-reference/simular-pagamento-de-transação-sandbox",
      "destination": "/pages/pix/simulate-payment"
    },
    {
      "source": "/api-reference/checkout/criar-sessão-de-checkout",
      "destination": "/pages/checkout/create"
    },
    {
      "source": "/api-reference/checkout/consultar-status-da-sessão",
      "destination": "/pages/checkout/status"
    },
    {
      "source": "/api-reference/listar-todos-os-clientes",
      "destination": "/pages/customers/list"
    },
    {
      "source": "/api-reference/buscar-cliente-por-id",
      "destination": "/pages/customers/get"
    },
    {
      "source": "/api-reference/buscar-detalhes-da-loja",
      "destination": "/pages/store/get"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.payments.bob.company",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "default": true,
        "tabs": [
          {
            "tab": "Documentação",
            "groups": [
              {
                "group": "Primeiros passos",
                "pages": [
                  "pages/introduction",
                  "pages/quickstart"
                ]
              },
              {
                "group": "Conceitos principais",
                "pages": [
                  "pages/concepts/payment-flow",
                  "pages/concepts/transactions",
                  "pages/concepts/customers",
                  "pages/concepts/webhooks"
                ]
              },
              {
                "group": "Formas de integração",
                "pages": [
                  "pages/payments",
                  "pages/checkout/overview",
                  "pages/credit-card/overview"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "pages/webhooks"
                ]
              },
              {
                "group": "Usando a Bob",
                "pages": [
                  "pages/sandbox",
                  "pages/authentication",
                  "pages/production"
                ]
              },
              {
                "group": "Fundamentos da API",
                "pages": [
                  "pages/idempotency",
                  "pages/errors"
                ]
              }
            ]
          },
          {
            "tab": "Referência da API",
            "groups": [
              {
                "group": "Transações",
                "pages": [
                  "pages/pix/reference",
                  "pages/credit-card/reference",
                  "pages/pix/create",
                  "pages/pix/list",
                  "pages/pix/check-status"
                ]
              },
              {
                "group": "Checkout",
                "pages": [
                  "pages/checkout/create",
                  "pages/checkout/status"
                ]
              },
              {
                "group": "Clientes",
                "pages": [
                  "pages/customers/reference",
                  "pages/customers/get",
                  "pages/customers/list"
                ]
              },
              {
                "group": "Projeto",
                "pages": [
                  "pages/store/reference",
                  "pages/store/get"
                ]
              },
              {
                "group": "Sandbox",
                "pages": [
                  "pages/pix/simulate-payment"
                ]
              }
            ]
          },
          {
            "tab": "SDKs",
            "groups": [
              {
                "group": "Comece aqui",
                "pages": [
                  "pages/sdk/overview"
                ]
              },
              {
                "group": "Servidor",
                "pages": [
                  "pages/sdk/node",
                  "pages/sdk/php"
                ]
              },
              {
                "group": "Frontend",
                "pages": [
                  "pages/sdk/checkout"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "href": "https://github.com/BobPayments/documentation/blob/main/CHANGELOG.md"
          }
        ]
      }
    ]
  }
}
