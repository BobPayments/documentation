{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "name": "Bob Payments",
  "description": "Documentação da API Bob Payments para criar, acompanhar e conciliar pagamentos com PIX.",
  "logo": {
    "light": "/logo/bob-logo-sm.webp",
    "dark": "/logo/bob-logo-sm.webp",
    "href": "/pages/introduction"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#087A60",
    "light": "#5EE0B5",
    "dark": "#087A60"
  },
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1210"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Repositório",
        "href": "https://github.com/BobPayments/documentation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.payments.bob.company"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Produto",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.payments.bob.company"
          },
          {
            "label": "Preços",
            "href": "https://app.payments.bob.company/pricing"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Documentação",
            "href": "/"
          }
        ]
      },
      {
        "header": "Suporte",
        "items": [
          {
            "label": "Falar com o suporte",
            "href": "mailto:suporte@payments.bob.company"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Buscar..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/introduction"
    },
    {
      "source": "/pages/setup-account",
      "destination": "/pages/authentication"
    },
    {
      "source": "/pages/environments",
      "destination": "/pages/pix/simulate-payment"
    },
    {
      "source": "/pages/concepts/payment-flow",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/pages/concepts/webhooks",
      "destination": "/pages/webhooks"
    },
    {
      "source": "/pages/payments",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/pages/sandbox",
      "destination": "/pages/pix/simulate-payment"
    },
    {
      "source": "/pages/production",
      "destination": "/pages/authentication"
    },
    {
      "source": "/pages/concepts/transactions",
      "destination": "/pages/pix/reference"
    },
    {
      "source": "/pages/concepts/customers",
      "destination": "/pages/customers/reference"
    },
    {
      "source": "/pages/idempotency",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/pages/errors",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/en",
      "destination": "/pages/introduction"
    },
    {
      "source": "/en/:slug*",
      "destination": "/:slug*"
    },
    {
      "source": "/api-reference",
      "destination": "/pages/pix/create"
    },
    {
      "source": "/api-reference/criar-nova-transação",
      "destination": "/pages/pix/create"
