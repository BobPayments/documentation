  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.payments.bob.company",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Comece aqui",
        "groups": [
          {
            "group": "Introdução",
            "pages": [
              "pages/introduction",
              "pages/quickstart",
              "pages/authentication"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "pages/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "pages/pix/create",
              "pages/pix/list",
              "pages/pix/check-status",
              "pages/pix/simulate-payment",
              "pages/customers/list",
              "pages/customers/get",
